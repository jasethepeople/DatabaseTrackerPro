# Environment Configuration Example
# Copy this file to .env and update with your actual values

# Database Configuration
DATABASE_URL=postgresql://username:password@localhost:5432/ai_agent_db

# Authentication Secrets
JWT_SECRET=your-super-secret-jwt-key-here-make-it-long-and-random
SESSION_SECRET=your-session-secret-here-also-make-it-long-and-random

# AI API Keys (Optional)
OPENAI_API_KEY=your-openai-api-key-optional
ANTHROPIC_API_KEY=your-anthropic-api-key-optional

# Application Settings
NODE_ENV=development
PORT=5000

# Security Settings
ENCRYPTION_KEY=your-32-character-encryption-key-here

# Database Options
# Option 1: Use Neon serverless database (recommended)
# DATABASE_URL=postgresql://user:pass@ep-xyz.us-east-1.aws.neon.tech/ai_agent_db

# Option 2: Use local PostgreSQL
# DATABASE_URL=postgresql://postgres:password@localhost:5432/ai_agent_db