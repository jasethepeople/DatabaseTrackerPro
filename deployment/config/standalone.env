# Standalone Configuration for Windows 11
NODE_ENV=production
PORT=5000

# Database Configuration (SQLite for standalone)
DATABASE_URL=sqlite:./data/database.db
DB_TYPE=sqlite

# Security Settings
ENABLE_CORS=false
ALLOWED_ORIGINS=http://localhost:5000
SECURE_COOKIES=true
SESSION_SECRET=local-dev-env-secure-session-key-windows-11

# Storage Configuration
STORAGE_PATH=./data
LOG_PATH=./logs
TEMP_PATH=./temp
UPLOADS_PATH=./data/uploads

# AI Configuration (Offline modes)
ENABLE_OFFLINE_AI=true
AI_MODEL_PATH=./models
CODE_GENERATION_MODE=local

# Feature Flags
UNRESTRICTED_MODE=true
OFFLINE_CAPABLE=true
NO_TELEMETRY=true
LOCAL_STORAGE_ONLY=true

# Windows-Specific Settings
WINDOWS_SERVICE=false
SYSTEM_TRAY=true
AUTO_START=false
DESKTOP_NOTIFICATIONS=true

# Performance Settings
MAX_MEMORY_USAGE=4096
WORKER_THREADS=8
ENABLE_CLUSTERING=false

# Network Settings
BIND_ADDRESS=127.0.0.1
ENABLE_HTTPS=false
ALLOW_EXTERNAL_ACCESS=false

# Logging
LOG_LEVEL=info
ENABLE_ACCESS_LOGS=true
ENABLE_ERROR_LOGS=true

# Intel 13th Gen Optimizations
CPU_OPTIMIZATION=intel-13th-gen
ENABLE_SIMD=true
MEMORY_MANAGEMENT=optimized